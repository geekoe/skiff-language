{
  "schemaVersion": "skiff-router-rust-bootstrap-chain-corpus-v1",
  "states": [
    {
      "id": "committed-only",
      "kind": "committedOnly",
      "repositoryRead": "ok",
      "bootstrapOutcome": "stableCommitted"
    },
    {
      "id": "pending-present",
      "kind": "pendingPresent",
      "repositoryRead": "ok",
      "bootstrapOutcome": "recoverPending"
    },
    {
      "id": "missing-profile",
      "kind": "missing",
      "repositoryRead": "reject",
      "bootstrapOutcome": "failClosedMissing"
    },
    {
      "id": "malformed-record",
      "kind": "malformed",
      "repositoryRead": "reject",
      "bootstrapOutcome": "failClosedMalformed"
    },
    {
      "id": "committed-ref-missing",
      "kind": "committedRefMissing",
      "repositoryRead": "reject",
      "bootstrapOutcome": "failClosedIdentityMismatch"
    },
    {
      "id": "committed-ref-mismatch",
      "kind": "committedRefMismatch",
      "repositoryRead": "reject",
      "bootstrapOutcome": "failClosedIdentityMismatch"
    }
  ],
  "projection": {
    "input": "CommittedActivation { generation, assembly: RuntimeAssemblyRef, config_snapshot: RuntimeConfigSnapshotRef }",
    "output": "CommittedBootstrapRefs { generation, assembly: RuntimeAssemblyRef, config_snapshot: RuntimeConfigSnapshotRef }",
    "pending": "no projection",
    "wire": "RouterBootstrapActivationFrameHeader { profile, generation, assembly, configSnapshot }"
  },
  "epoch": {
    "fields": [
      "profile",
      "assemblyGeneration",
      "assemblyIdentity",
      "configSnapshotId",
      "immutableIngressDeploymentActorProjection"
    ],
    "publication": "atomic-arc-replacement",
    "singleAuthority": true,
    "pendingNeverEnters": true,
    "actorProjectionOwner": "A0"
  }
}
