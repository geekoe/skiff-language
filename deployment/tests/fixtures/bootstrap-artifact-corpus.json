{
  "schemaVersion": "skiff-router-rust-bootstrap-artifact-corpus-v1",
  "assemblyRefs": [
    {
      "id": "valid",
      "json": {
        "assemblyIdentity": "skiff-runtime-assembly-v3:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "valid": true
    },
    {
      "id": "wrong-prefix",
      "json": {
        "assemblyIdentity": "skiff-runtime-assembly-v2:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "valid": false,
      "expectErrorContains": "assemblyIdentity must use skiff-runtime-assembly-v3:sha256"
    },
    {
      "id": "short-hash",
      "json": {
        "assemblyIdentity": "skiff-runtime-assembly-v3:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "valid": false,
      "expectErrorContains": "assemblyIdentity must use"
    },
    {
      "id": "uppercase-hex",
      "json": {
        "assemblyIdentity": "skiff-runtime-assembly-v3:sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      },
      "valid": false,
      "expectErrorContains": "assemblyIdentity must use"
    },
    {
      "id": "unknown-field",
      "json": {
        "assemblyIdentity": "skiff-runtime-assembly-v3:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "extra": 1
      },
      "valid": false,
      "expectErrorContains": "unknown field"
    },
    {
      "id": "missing-field",
      "json": {},
      "valid": false,
      "expectErrorContains": "missing field"
    }
  ],
  "recordCases": [
    {
      "id": "valid-empty-assembly",
      "kind": "valid",
      "expect": "ok"
    },
    {
      "id": "missing-record",
      "kind": "missing",
      "expect": "reject",
      "expectErrorContains": "No such file"
    },
    {
      "id": "malformed-json",
      "kind": "malformed",
      "expect": "reject",
      "expectErrorContains": "strict JSON parse failed"
    },
    {
      "id": "identity-mismatch",
      "kind": "identityMismatch",
      "expect": "reject",
      "expectErrorContains": "but content identity is"
    },
    {
      "id": "non-canonical-bytes",
      "kind": "nonCanonical",
      "expect": "reject",
      "expectErrorContains": "not canonical JSON"
    },
    {
      "id": "unknown-field",
      "kind": "unknownField",
      "expect": "reject",
      "expectErrorContains": "unknown field"
    },
    {
      "id": "schema-version-mismatch",
      "kind": "schemaVersionMismatch",
      "expect": "reject",
      "expectErrorContains": "schemaVersion must be"
    }
  ]
}
