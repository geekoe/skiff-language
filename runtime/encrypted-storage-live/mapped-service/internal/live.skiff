import std

type RotationBarrier {
  id: string,
  token: string,
  active: bool,
}

db object RotationBarrier {
  primary key(id)
}

type BarrierInput {
  token: string,
}

type BarrierStatus {
  active: bool,
}

type Credential {
  id: string,
  apiKey: string,
  label: string,
  sequence: number,
}

db object Credential {
  name "Credential"
  primary key(id)
  storage apiKey using encrypted
}

type CredentialInput {
  id: string,
  apiKey: string,
  label: string,
  sequence: number,
}

type CredentialBatchInput {
  rows: Array<Credential>,
}

type IdInput {
  id: string,
}

type ScanInput {
  lastId: string,
}

function guard(request: std.http.HttpRequest) -> std.http.HttpResponse? {
  return null
}

function writerBarrier(request: std.http.HttpRequest) -> std.http.HttpResponse? {
  const barrier = db find RotationBarrier("encrypted-storage-live")
  if barrier == null || !barrier.active {
    return null
  }
  const provided = std.http.header(request, "x-skiff-rotation-token")
  if provided != null && provided == barrier.token {
    return null
  }
  return std.http.errorResponse(423, "rotation_writer_barrier", "rotation writer barrier is active", null)
}

function activateBarrier(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const input = std.http.decodeJson<BarrierInput>(request)
  const result = db upsert RotationBarrier("encrypted-storage-live") {
    token = input.token
    active = true
  } {
    token = input.token
    active = true
  }
  return std.http.json(200, BarrierStatus { active: result.value.active })
}

function barrierStatus(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const barrier = db find RotationBarrier("encrypted-storage-live")
  return std.http.json(200, BarrierStatus { active: barrier != null && barrier.active })
}

function insertServiceContextProbe(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const blocked = writerBarrier(request)
  if blocked != null { return blocked }
  const input = std.http.decodeJson<CredentialInput>(request)
  const row = db insert Credential {
    id = input.id
    apiKey = input.apiKey
    label = input.label
    sequence = input.sequence
  }
  return std.http.json(200, row)
}

function readServiceContextProbe(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const input = std.http.decodeJson<IdInput>(request)
  return std.http.json(200, db require Credential(input.id))
}

function scanServiceContextProbe(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const input = std.http.decodeJson<ScanInput>(request)
  const rows = db find many Credential { where id > input.lastId order id asc limit 100 }
  return std.http.json(200, rows)
}

function rewriteServiceContextProbe(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const blocked = writerBarrier(request)
  if blocked != null { return blocked }
  const input = std.http.decodeJson<CredentialInput>(request)
  const row = db update Credential(input.id) { apiKey = input.apiKey }
  return std.http.json(200, row)
}

function rewriteServiceContextProbeBatch(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const blocked = writerBarrier(request)
  if blocked != null { return blocked }
  const input = std.http.decodeJson<CredentialBatchInput>(request)
  db transaction {
    for row in input.rows {
      db update Credential(row.id) { apiKey = row.apiKey }
    }
  }
  return std.http.json(200, input.rows)
}

function restoreServiceContextProbe(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const blocked = writerBarrier(request)
  if blocked != null { return blocked }
  const input = std.http.decodeJson<CredentialInput>(request)
  const row = db update Credential(input.id) {
    apiKey = input.apiKey
    label = input.label
    sequence = input.sequence
  }
  return std.http.json(200, row)
}

function insertOne(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const blocked = writerBarrier(request)
  if blocked != null { return blocked }
  return encryptedStore.insertOne(request)
}

function readOne(request: std.http.HttpRequest) -> std.http.HttpResponse {
  return encryptedStore.readOne(request)
}

function scan(request: std.http.HttpRequest) -> std.http.HttpResponse {
  return encryptedStore.scan(request)
}

function rewrite(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const blocked = writerBarrier(request)
  if blocked != null { return blocked }
  return encryptedStore.rewrite(request)
}

function rewriteBatch(request: std.http.HttpRequest) -> std.http.HttpResponse {
  const blocked = writerBarrier(request)
  if blocked != null { return blocked }
  return encryptedStore.rewriteBatch(request)
}
