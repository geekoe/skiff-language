import std

type Counter {
  id: string,
  count: number,
}

actor Counter {
  key(id)
  create()
}

impl Counter {
  function create() -> void {
    self.count = 0
  }

  function bad() -> void {
    dispatch self.increment()
  }

  function increment() -> number {
    self.count = self.count + 1
    return self.count
  }
}

function run(seed: number) -> number {
  final counter = std.actor.get<Counter>("phase7-compaction")
  counter.bad()
  return seed
}