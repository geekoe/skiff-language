type RecoverableDoc {
  id: string,
  value: string,
}

db object RecoverableDoc {
  primary key(id)
}

function run(seed: number) -> number {
  db transaction {
    db insert RecoverableDoc { id = "nested" value = "bad" }
    db transaction {
      db delete RecoverableDoc("nested")
    }
  }
  return seed
}
