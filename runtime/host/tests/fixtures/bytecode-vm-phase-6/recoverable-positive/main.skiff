import std

function durable(value: string) -> void {
  return
}

function run(request: std.http.HttpRequest) -> Stream<std.http.HttpResponseStreamEvent> {
  final task = dispatch durable("recoverable")
  emit({ tag: "start", status: 200, headers: [] })
  emit({ tag: "chunk", value: bytes.fromUtf8("dispatched") })
  emit({ tag: "end" })
  return null
}
