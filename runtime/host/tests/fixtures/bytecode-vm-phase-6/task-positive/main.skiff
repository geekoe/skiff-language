import std

type TaskEntry {
  id: string,
  task: std.task.TaskRef,
}

db object TaskEntry {
  primary key(id)
}

function work(value: string) -> void {
  return
}

function run(request: std.http.HttpRequest) -> Stream<std.http.HttpResponseStreamEvent> {
  final task = dispatch work("task")
  db insert TaskEntry { id = "phase6-task" task = task }
  emit({ tag: "start", status: 200, headers: [] })
  emit({ tag: "chunk", value: bytes.fromUtf8("task-ok") })
  emit({ tag: "end" })
  return null
}
