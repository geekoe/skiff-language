{
  "schemaVersion": 1,
  "scenario": "15-four-way-runtime-disconnect-then-replacement",
  "limits": { "connectionLimit": 4, "slowClientBudgetBytes": 1024, "perGenerationCapacity": 2 },
  "events": [
    { "kind": "acceptConnection", "connection": "c1", "businessKey": "b1", "maxConnections": 1, "overflow": "close-oldest" },
    { "kind": "attach", "connection": "c1", "socketGeneration": "g1", "runtime": "r1" },
    { "kind": "acquirePin", "connection": "c1", "runtime": "r1" },
    { "kind": "runtimeDisconnect", "runtime": "r1" },
    { "kind": "acceptConnection", "connection": "c2", "businessKey": "b1", "maxConnections": 1, "overflow": "close-oldest" },
    { "kind": "attach", "connection": "c2", "socketGeneration": "g2", "runtime": "r2" },
    { "kind": "acquirePin", "connection": "c2", "runtime": "r2" },
    { "kind": "peerClose", "connection": "c2" },
    { "kind": "releasePin", "connection": "c2", "mode": "ack" }
  ],
  "expect": {
    "terminals": { "c1": "RuntimeDisconnect", "c2": "PeerClose" },
    "connectionCount": 0,
    "generationCount": 0,
    "outboundPending": 0,
    "inboundPending": 0,
    "tombstones": 0,
    "pinsAcquired": 0,
    "pinsPendingRelease": 0,
    "releaseAcks": 1,
    "finalizerCount": 2,
    "runtimeClosed": false,
    "failStop": false,
    "openConnections": []
  }
}
