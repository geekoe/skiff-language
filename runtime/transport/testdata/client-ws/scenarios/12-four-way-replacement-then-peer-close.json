{
  "schemaVersion": 1,
  "scenario": "12-four-way-replacement-then-peer-close",
  "limits": {
    "connectionLimit": 4,
    "slowClientBudgetBytes": 1024,
    "perGenerationCapacity": 2
  },
  "events": [
    {
      "kind": "acceptConnection",
      "connection": "c1",
      "businessKey": "b1",
      "maxConnections": 1,
      "overflow": "close-oldest"
    },
    {
      "kind": "attach",
      "connection": "c1",
      "socketGeneration": "g1",
      "runtime": "r1"
    },
    {
      "kind": "acceptConnection",
      "connection": "c2",
      "businessKey": "b1",
      "maxConnections": 1,
      "overflow": "close-oldest"
    },
    {
      "kind": "peerClose",
      "connection": "c1"
    },
    {
      "kind": "attach",
      "connection": "c2",
      "socketGeneration": "g2",
      "runtime": "r1"
    },
    {
      "kind": "peerClose",
      "connection": "c2"
    }
  ],
  "expect": {
    "terminals": {
      "c1": "Replacement",
      "c2": "PeerClose"
    },
    "connectionCount": 0,
    "generationCount": 0,
    "outboundPending": 0,
    "inboundPending": 0,
    "tombstones": 0,
    "finalizerCount": 2,
    "openConnections": []
  }
}
