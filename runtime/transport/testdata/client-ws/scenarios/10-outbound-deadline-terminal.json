{
  "schemaVersion": 1,
  "scenario": "10-outbound-deadline-terminal",
  "limits": { "connectionLimit": 4, "slowClientBudgetBytes": 1024, "perGenerationCapacity": 2 },
  "events": [
    { "kind": "acceptConnection", "connection": "c1" },
    { "kind": "attach", "connection": "c1", "socketGeneration": "g1", "runtime": "r1" },
    { "kind": "acquirePin", "connection": "c1", "runtime": "r1" },
    { "kind": "runtimeRequest", "connection": "c1", "requestId": "req-1", "deadlineMs": 100 },
    { "kind": "deadline", "connection": "c1", "requestId": "req-1" }
  ],
  "expect": {
    "terminals": { "c1": "None" },
    "connectionCount": 1,
    "generationCount": 1,
    "outboundPending": 0,
    "inboundPending": 0,
    "tombstones": 1,
    "pinsAcquired": 1,
    "pinsPendingRelease": 0,
    "releaseAcks": 0,
    "finalizerCount": 0,
    "runtimeClosed": false,
    "failStop": false,
    "openConnections": ["c1"]
  }
}
