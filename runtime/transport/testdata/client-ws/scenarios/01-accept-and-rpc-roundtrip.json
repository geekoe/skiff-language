{
  "schemaVersion": 1,
  "scenario": "01-accept-and-rpc-roundtrip",
  "limits": { "connectionLimit": 4, "slowClientBudgetBytes": 1024, "perGenerationCapacity": 2 },
  "events": [
    { "kind": "acceptConnection", "connection": "c1" },
    { "kind": "attach", "connection": "c1", "socketGeneration": "g1", "runtime": "r1" },
    { "kind": "acquirePin", "connection": "c1", "runtime": "r1" },
    { "kind": "runtimeRequest", "connection": "c1", "requestId": "req-1" },
    { "kind": "peerResponse", "connection": "c1", "peerId": "g1:0" },
    { "kind": "releasePin", "connection": "c1", "mode": "initiate" },
    { "kind": "releasePin", "connection": "c1", "mode": "ack" },
    { "kind": "peerClose", "connection": "c1" }
  ],
  "expect": {
    "terminals": { "c1": "PeerClose" },
    "connectionCount": 0,
    "generationCount": 0,
    "outboundPending": 0,
    "inboundPending": 0,
    "tombstones": 0,
    "pinsAcquired": 0,
    "pinsPendingRelease": 0,
    "releaseAcks": 1,
    "finalizerCount": 1,
    "runtimeClosed": false,
    "failStop": false,
    "openConnections": []
  }
}
