{
  "schemaVersion": 1,
  "scenario": "20-inbound-deadline-terminal",
  "limits": { "connectionLimit": 4, "slowClientBudgetBytes": 1024, "perGenerationCapacity": 2 },
  "events": [
    { "kind": "acceptConnection", "connection": "c1" },
    { "kind": "attach", "connection": "c1", "socketGeneration": "g1", "runtime": "r1" },
    { "kind": "peerRequest", "connection": "c1", "peerId": "p1" },
    { "kind": "inboundDispatch", "connection": "c1", "peerId": "p1", "result": "deadlineExceeded" }
  ],
  "expect": {
    "terminals": { "c1": "None" },
    "connectionCount": 1,
    "generationCount": 1,
    "outboundPending": 0,
    "inboundPending": 0,
    "tombstones": 1,
    "pinsAcquired": 0,
    "pinsPendingRelease": 0,
    "releaseAcks": 0,
    "finalizerCount": 0,
    "runtimeClosed": false,
    "failStop": false,
    "openConnections": ["c1"]
  }
}
