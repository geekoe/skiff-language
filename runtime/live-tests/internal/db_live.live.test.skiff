import std

test defaultRun false

test "live service db persists object db operations" {
  const marker = root.internal.db_live.marker()
  const docId = "runtime-live-db-".concat(std.crypto.uuidSimple())

  const inserted = db insert root.internal.db_live.RuntimeLiveDoc { id = docId value = marker visits = 1 rank = 10 }
  assert inserted.id == docId
  assert inserted.value == marker
  assert inserted.visits == 1
  assert inserted.rank == 10

  const read = db require root.internal.db_live.RuntimeLiveDoc(docId)
  assert read.id == docId
  assert read.value == marker

  const found = db find root.internal.db_live.RuntimeLiveDoc(docId)
  assert found != null
  assert found.id == docId

  const updated = db update root.internal.db_live.RuntimeLiveDoc(docId) { visits += 1 }
  assert updated != null
  assert updated.visits == 2
  assert db exists root.internal.db_live.RuntimeLiveDoc(docId)
  assert db count root.internal.db_live.RuntimeLiveDoc { where id == docId } == 1

  const deleted = db delete root.internal.db_live.RuntimeLiveDoc(docId)
  assert deleted
  assert !db exists root.internal.db_live.RuntimeLiveDoc(docId)
}

test "live service db supports find order offset replace upsert and transaction" {
  const marker = root.internal.db_live.marker()
  const prefix = "runtime-live-db-".concat(std.crypto.uuidSimple())
  const firstId = prefix.concat("-a")
  const secondId = prefix.concat("-b")
  const thirdId = prefix.concat("-c")
  const upsertId = prefix.concat("-upsert")
  const rollbackId = prefix.concat("-rollback")

  db insert root.internal.db_live.RuntimeLiveDoc { id = firstId value = marker.concat("-first") visits = 1 rank = 10 }
  db insert root.internal.db_live.RuntimeLiveDoc { id = secondId value = marker.concat("-second") visits = 2 rank = 20 }
  db insert root.internal.db_live.RuntimeLiveDoc { id = thirdId value = marker.concat("-third") visits = 3 rank = 30 }

  const ordered = db find many root.internal.db_live.RuntimeLiveDoc { where id != null order rank asc offset 1 limit 1 }
  assert ordered.length() == 1
  for row in ordered {
    assert row.id == secondId
    assert row.rank == 20
  }

  const replaced = db replace root.internal.db_live.RuntimeLiveDoc(secondId) { value = marker.concat("-replaced") visits = 22 rank = 25 }
  assert replaced != null
  assert replaced.id == secondId
  assert replaced.value == marker.concat("-replaced")
  assert replaced.visits == 22

  const upsertInserted = db upsert root.internal.db_live.RuntimeLiveDoc(upsertId) { value = marker.concat("-created") visits = 1 rank = 40 } { visits += 1 }
  assert upsertInserted.inserted
  assert upsertInserted.value.id == upsertId
  assert upsertInserted.value.visits == 1

  const upsertUpdated = db upsert root.internal.db_live.RuntimeLiveDoc(upsertId) { value = marker.concat("-created") visits = 1 rank = 40 } { visits += 1 }
  assert !upsertUpdated.inserted
  assert upsertUpdated.value.visits == 2

  db transaction {
    db update root.internal.db_live.RuntimeLiveDoc(firstId) { visits += 10 }
    db delete root.internal.db_live.RuntimeLiveDoc(thirdId)
  }

  assert db require root.internal.db_live.RuntimeLiveDoc(firstId).visits == 11
  assert !db exists root.internal.db_live.RuntimeLiveDoc(thirdId)

  const committed = db transaction value {
    db require root.internal.db_live.RuntimeLiveDoc(upsertId)
  }
  assert committed.visits == 2

  db insert root.internal.db_live.RuntimeLiveDoc { id = rollbackId value = marker.concat("-rollback") visits = 1 rank = 50 }
  const beforeRollback = db require root.internal.db_live.RuntimeLiveDoc(firstId).visits
  const rollback = catch<root.internal.db_live.RuntimeLiveRollbackError>(root.internal.db_live.rollbackProbe(firstId))
  assert rollback.tag == "err"
  assert db require root.internal.db_live.RuntimeLiveDoc(firstId).visits == beforeRollback

  db delete root.internal.db_live.RuntimeLiveDoc(firstId)
  db delete root.internal.db_live.RuntimeLiveDoc(secondId)
  db delete root.internal.db_live.RuntimeLiveDoc(upsertId)
  db delete root.internal.db_live.RuntimeLiveDoc(rollbackId)
}

test "live service db claim reads releases and fences writes" {
  const marker = root.internal.db_live.marker()
  const docId = "runtime-live-lease-".concat(std.crypto.uuidSimple())

  db insert root.internal.db_live.RuntimeLiveDoc { id = docId value = marker visits = 1 rank = 10 }

  const firstClaim = root.internal.db_live.claimAndUpdateProbe(docId)
  assert firstClaim
  assert db require root.internal.db_live.RuntimeLiveDoc(docId).visits == 2
  assert db lease root.internal.db_live.RuntimeLiveDoc(docId).drain == null

  const secondClaim = root.internal.db_live.claimAndUpdateProbe(docId)
  assert secondClaim
  assert db require root.internal.db_live.RuntimeLiveDoc(docId).visits == 3

  db delete root.internal.db_live.RuntimeLiveDoc(docId)
}

test "live service db dynamically rejects claim inside transaction" {
  const marker = root.internal.db_live.marker()
  const docId = "runtime-live-lease-tx-".concat(std.crypto.uuidSimple())

  db insert root.internal.db_live.RuntimeLiveDoc { id = docId value = marker visits = 1 rank = 10 }
  const rejected = catch<std.db.DecodeError>(db transaction value {
    root.internal.db_live.dynamicTransactionClaimProbe(docId)
  })

  assert rejected.tag == "err"
  assert db require root.internal.db_live.RuntimeLiveDoc(docId).visits == 1
  db delete root.internal.db_live.RuntimeLiveDoc(docId)
}
