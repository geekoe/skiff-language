    {
      "id": "http-health-basic",
      "status": "planned",
      "lane": "http",
      "description": "Health JSON parity: activeAssembly tuple, replicas and capabilityConnections must deep-equal after timestamp normalization. Blocked on the Rust production health endpoint (W-composition/E-http); the Rust listener currently returns a 200 empty placeholder.",
