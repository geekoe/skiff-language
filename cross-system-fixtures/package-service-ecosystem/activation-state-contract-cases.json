        {
          "op": "commit",
          "activationId": "activation-8",
          "expectedGeneration": 7,
          "candidateGeneration": 8,
          "connected": ["runtime-a", "runtime-b"],
          "prepared": ["runtime-a", "runtime-b"],
          "expected": "ok"
        },
        {
          "op": "commit",
          "activationId": "activation-8",
