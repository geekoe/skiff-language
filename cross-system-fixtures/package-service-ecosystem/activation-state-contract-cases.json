{
  "schemaVersion": "skiff-activation-state-contract-corpus-v1",
  "cases": [
    {
      "name": "prepare-idempotent-retry-and-conflict",
      "steps": [
        { "op": "initialize", "committedGeneration": 7, "assembly": "committed", "config": "a" },
        {
          "op": "prepare",
          "activationId": "activation-8",
          "expectedGeneration": 7,
          "candidateGeneration": 8,
          "assembly": "candidate",
          "config": "b",
          "participants": ["runtime-a", "runtime-b"],
          "expected": "ok"
        },
        {
          "op": "prepare",
          "activationId": "activation-8",
          "expectedGeneration": 7,
          "candidateGeneration": 8,
          "assembly": "candidate",
          "config": "b",
          "participants": ["runtime-a", "runtime-b"],
          "expected": "ok"
        },
        {
          "op": "prepare",
          "activationId": "activation-8x",
          "expectedGeneration": 7,
          "candidateGeneration": 8,
          "assembly": "candidate",
          "config": "b",
          "participants": ["runtime-a"],
          "expected": "casMismatch"
        },
        {
          "op": "read",
          "expectedGeneration": 7,
          "expectedPendingActivationId": "activation-8",
          "expectedParticipants": ["runtime-a", "runtime-b"]
        }
      ],
      "expected": { "terminal": "ok" }
    },
