import std

type SpawnStreamFailure { message: string }

function submittedReceiptSource(receipt: string) -> Stream<string> {
  emit(receipt)
  return null
}

function nestedSubmittedReceipt(input: Stream<string>) -> Stream<string> {
  for receipt in input {
    emit(receipt.concat(":nested"))
  }
  return null
}

function firstSubmittedReceipt(input: Stream<string>) -> string {
  for receipt in input {
    return receipt
  }
  return "missing"
}

function acceptSubmittedReceipt(receipt: string) -> void {
  final observed = firstSubmittedReceipt(
    nestedSubmittedReceipt(submittedReceiptSource(receipt))
  )
  if observed != receipt.concat(":nested") {
    throw SpawnStreamFailure { message: "derived spawn lost its nested request stream" }
  }
}

function submitSpawnReceipt() -> string {
  dispatch acceptSubmittedReceipt("P5-F45E-SPAWN-SUBMIT")
  return "P5-F45E-SPAWN-SUBMIT-TYPED-RESPONSE:submitted"
}

function __skiffHttpProbe(body: null) -> string {
  return submitSpawnReceipt()
}

function websocketConnect(
  request: std.websocket.WebSocketConnectRequest,
  connectionId: string
) -> std.websocket.WebSocketConnectResult {
  return {
    tag: "accept",
    businessIdentity: connectionId,
    connectionPolicy: null
  }
}
