import std
import helper

type ProducerFailure { message: string }

function source() -> Stream<string> {
  emit("body")
  return null
}

function entry(
  request: std.http.HttpRequest
) -> Stream<std.http.HttpResponseStreamEvent> {
  for event in helper/wrap(source()) {
    emit(event)
  }
  return null
}

function producerErrorSource() -> Stream<string> {
  emit("before-error")
  throw ProducerFailure { message: "expected producer failure" }
}

function producerErrorEntry(
  request: std.http.HttpRequest
) -> Stream<std.http.HttpResponseStreamEvent> {
  for event in helper/wrap(producerErrorSource()) {
    emit(event)
  }
  return null
}

function consumerCancelSource() -> Stream<string> {
  emit("first")
  std.time.sleep(Duration.milliseconds(10000))
  emit("late")
  return null
}

function consumerCancelEntry(
  request: std.http.HttpRequest
) -> Stream<std.http.HttpResponseStreamEvent> {
  for event in helper/wrap(consumerCancelSource()) {
    emit(event)
  }
  return null
}

test "normal stream-producing argument" {}

test "producer error stream-producing argument" {}

test "consumer cancel stream-producing argument" {}
