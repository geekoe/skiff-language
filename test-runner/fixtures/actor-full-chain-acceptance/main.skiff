import std

type Counter {
  id: string,
  count: number,
}

actor Counter {
  key(id)
  create()
}

impl Counter {
  function create() -> void {
    self.count = 0
  }

  function increment() -> string {
    if self.count == 0 {
      self.count = 1
      return "actor-count-1"
    }
    self.count = self.count + 1
    return "actor-count-next"
  }
}

type Slow {
  id: string,
  count: number,
}

actor Slow {
  key(id)
  create()
}

impl Slow {
  function create() -> void {
    std.time.sleep(300)
    self.count = 0
  }

  function increment() -> string {
    self.count = self.count + 1
    return "slow-ok"
  }
}

type Flaky {
  id: string,
}

actor Flaky {
  key(id)
  create()
}

impl Flaky {
  function create() -> void {
    std.time.sleep(100)
    throw std.service.ProtocolError {
      target: "flaky-actor",
      message: "create boom",
    }
  }

  function ping() -> string {
    return "flaky-ping"
  }
}

function marker() -> string {
  final counter = std.actor.get<Counter>("shared")
  return counter.increment()
}

function __skiffHttpProbe(body: null) -> string {
  return marker()
}

function slowGetOnly(body: null) -> string {
  final slow = std.actor.get<Slow>("slow")
  return "slow-get-ok"
}

function slowDedup(body: null) -> string {
  final slow = std.actor.get<Slow>("slow-dedup")
  return "slow-get-ok"
}

function slowIncrement(body: null) -> string {
  final slow = std.actor.get<Slow>("slow")
  return slow.increment()
}

function flakyGet(body: null) -> string {
  final flaky = std.actor.get<Flaky>("flaky")
  return flaky.ping()
}

// A synchronous self-call must use the currently executing Actor reference as
// the receiver. The nested call waits for the same instance, so the outer
// continuation releases the scheduler and then resumes with the nested
// method's committed field state.
type SelfCalling {
  id: string,
  count: number,
}

actor SelfCalling {
  key(id)
  create()
}

impl SelfCalling {
  function create() -> void {
    self.count = 0
  }

  function add(value: number) -> number {
    self.count = self.count + value
    return self.count
  }

  function addViaSelf(value: number) -> number {
    self.count = self.count + 1
    final nested = self.add(value)
    self.count = self.count + 100
    return self.count
  }

  function count() -> number {
    return self.count
  }
}

function synchronousSelfCall(body: null) -> number {
  final target = std.actor.get<SelfCalling>("synchronous-self")
  return target.addViaSelf(4)
}

function synchronousSelfCount(body: null) -> number {
  final target = std.actor.get<SelfCalling>("synchronous-self")
  return target.count()
}

type Spawned {
  id: string,
  count: number,
  history: string,
}

actor Spawned {
  key(id)
  create()
}

impl Spawned {
  function create() -> void {
    self.count = 0
    self.history = ""
  }

  function record(tag: string) -> void {
    std.time.sleep(500)
    self.count = self.count + 1
    self.history = self.history.concat(tag)
  }

  function count() -> number {
    return self.count
  }

  function history() -> string {
    return self.history
  }

  function kickSelf(tag: string) -> string {
    dispatch self.record(tag)
    return "kicked"
  }

  function fanout() -> string {
    dispatch self.record("a")
    dispatch self.record("b")
    dispatch self.record("c")
    return "fanned"
  }
}

function spawnExternal(body: null) -> string {
  final target = std.actor.get<Spawned>("external")
  dispatch target.record("x")
  return "external-submitted"
}

function externalCount(body: null) -> number {
  final target = std.actor.get<Spawned>("external")
  return target.count()
}

function externalHistory(body: null) -> string {
  final target = std.actor.get<Spawned>("external")
  return target.history()
}

function spawnSelfKick(body: null) -> string {
  final target = std.actor.get<Spawned>("self-kick")
  return target.kickSelf("s")
}

function selfKickCount(body: null) -> number {
  final target = std.actor.get<Spawned>("self-kick")
  return target.count()
}

function selfKickHistory(body: null) -> string {
  final target = std.actor.get<Spawned>("self-kick")
  return target.history()
}

function spawnFanout(body: null) -> string {
  final target = std.actor.get<Spawned>("fanout")
  return target.fanout()
}

function fanoutCount(body: null) -> number {
  final target = std.actor.get<Spawned>("fanout")
  return target.count()
}

function fanoutHistory(body: null) -> string {
  final target = std.actor.get<Spawned>("fanout")
  return target.history()
}

// Chained self-spawn: tick spawns itself once per step. If a spawned call
// were executed nested in the submitting method's stack, a 160-step chain
// would exceed the runtime's programCallDepth safety limit (128); queued
// serial execution must complete all steps without depth growth.
type Chain {
  id: string,
  steps: number,
  history: string,
}

actor Chain {
  key(id)
  create()
}

impl Chain {
  function create() -> void {
    self.steps = 0
    self.history = ""
  }

  function tick(tag: string) -> void {
    if self.steps >= 160 {
      return null
    }
    self.steps = self.steps + 1
    self.history = self.history.concat(tag)
    dispatch self.tick(tag)
  }

  function chainKick(tag: string) -> string {
    dispatch self.tick(tag)
    return "chain-kicked"
  }

  function steps() -> number {
    return self.steps
  }

  function history() -> string {
    return self.history
  }
}

function chainKick(body: null) -> string {
  final target = std.actor.get<Chain>("chain")
  return target.chainKick("c")
}

function chainSteps(body: null) -> number {
  final target = std.actor.get<Chain>("chain")
  return target.steps()
}

function chainHistory(body: null) -> string {
  final target = std.actor.get<Chain>("chain")
  return target.history()
}

// A spawned actor method that throws a user exception must still construct a
// request-local exception from the caller's trace id. Without spawn trace
// penetration the failure is reported as "request-local exception requires a
// non-empty request trace id" instead of the user exception.
type Throwing {
  id: string,
  history: string,
}

actor Throwing {
  key(id)
  create()
}

impl Throwing {
  function create() -> void {
    self.history = ""
  }

  function boom(tag: string) -> void {
    self.history = tag
    throw std.service.ProtocolError {
      target: "throwing-actor",
      message: "spawn boom",
    }
  }
}

function spawnThrow(body: null) -> string {
  final target = std.actor.get<Throwing>("throwing")
  dispatch target.boom("t")
  return "throw-spawned"
}
