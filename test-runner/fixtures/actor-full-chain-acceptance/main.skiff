import std

type Counter {
  id: string,
  count: number,
}

actor Counter {
  key(id)
  create()
}

impl Counter {
  function create() -> void {
    self.count = 0
  }

  function increment() -> string {
    if self.count == 0 {
      self.count = 1
      return "actor-count-1"
    }
    self.count = self.count + 1
    return "actor-count-next"
  }
}

type Slow {
  id: string,
  count: number,
}

actor Slow {
  key(id)
  create()
}

impl Slow {
  function create() -> void {
    std.time.sleep(300)
    self.count = 0
  }

  function increment() -> string {
    self.count = self.count + 1
    return "slow-ok"
  }
}

type Flaky {
  id: string,
}

actor Flaky {
  key(id)
  create()
}

impl Flaky {
  function create() -> void {
    std.time.sleep(100)
    throw std.service.ProtocolError {
      target: "flaky-actor",
      message: "create boom",
    }
  }

  function ping() -> string {
    return "flaky-ping"
  }
}

function marker() -> string {
  const counter = std.actor.get<Counter>("shared")
  return counter.increment()
}

function __skiffHttpProbe(body: null) -> string {
  return marker()
}

function slowGetOnly(body: null) -> string {
  const slow = std.actor.get<Slow>("slow")
  return "slow-get-ok"
}

function slowDedup(body: null) -> string {
  const slow = std.actor.get<Slow>("slow-dedup")
  return "slow-get-ok"
}

function slowIncrement(body: null) -> string {
  const slow = std.actor.get<Slow>("slow")
  return slow.increment()
}

function flakyGet(body: null) -> string {
  const flaky = std.actor.get<Flaky>("flaky")
  return flaky.ping()
}

type Spawned {
  id: string,
  count: number,
  history: string,
}

actor Spawned {
  key(id)
  create()
}

impl Spawned {
  function create() -> void {
    self.count = 0
    self.history = ""
  }

  function record(tag: string) -> void {
    std.time.sleep(500)
    self.count = self.count + 1
    self.history = self.history.concat(tag)
  }

  function count() -> number {
    return self.count
  }

  function history() -> string {
    return self.history
  }

  function kickSelf(tag: string) -> string {
    spawn self.record(tag)
    return "kicked"
  }

  function fanout() -> string {
    spawn self.record("a")
    spawn self.record("b")
    spawn self.record("c")
    return "fanned"
  }
}

function spawnExternal(body: null) -> string {
  const target = std.actor.get<Spawned>("external")
  spawn target.record("x")
  return "external-submitted"
}

function externalCount(body: null) -> number {
  const target = std.actor.get<Spawned>("external")
  return target.count()
}

function externalHistory(body: null) -> string {
  const target = std.actor.get<Spawned>("external")
  return target.history()
}

function spawnSelfKick(body: null) -> string {
  const target = std.actor.get<Spawned>("self-kick")
  return target.kickSelf("s")
}

function selfKickCount(body: null) -> number {
  const target = std.actor.get<Spawned>("self-kick")
  return target.count()
}

function selfKickHistory(body: null) -> string {
  const target = std.actor.get<Spawned>("self-kick")
  return target.history()
}

function spawnFanout(body: null) -> string {
  const target = std.actor.get<Spawned>("fanout")
  return target.fanout()
}

function fanoutCount(body: null) -> number {
  const target = std.actor.get<Spawned>("fanout")
  return target.count()
}

function fanoutHistory(body: null) -> string {
  const target = std.actor.get<Spawned>("fanout")
  return target.history()
}
