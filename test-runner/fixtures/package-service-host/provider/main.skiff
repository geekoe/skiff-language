function handle(input: string) -> string {
  if input == "helper-mutated" { return "provider-observed-helper-mutated" }
  return "provider-rejected-unmutated"
}

interface LabelReader {
  function label(self: Self) -> string
  function events(self: Self) -> Stream<string>
}

type Worker implements LabelReader {
  value: string,
}

impl Worker {
  function label() -> string {
    return self.value.concat("")
  }

  function events() -> Stream<string> {
    if self.value == "left" {
      emit("left")
      emit("left-done")
      return null
    }
    emit("right")
    emit("right-done")
    return null
  }
}

const left: Worker = Worker { value: "left" }
const right: Worker = Worker { value: "right" }
