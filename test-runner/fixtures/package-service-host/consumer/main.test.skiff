test "provider observes helper mutation" {
  assert root.main.run() == "provider-observed-helper-mutated"
}

test "inline package effect sequence uses typed setup and request subset" effects {
  helper/tools.lookup {
    expect: { method: "POST" },
    sequence: [
      {
        expect: { url: "https://example.test/usercode" },
        respond: helper.EffectResponse { value: "first" },
      },
      {
        expect: { url: "https://example.test/deviceauth/token" },
        respond: helper.EffectResponse { value: "second" },
      },
      {
        expect: { url: "https://example.test/oauth/token" },
        respond: helper.EffectResponse { value: "third" },
      },
    ],
  }
} {
  assert root.main.effectLookup("https://example.test/usercode", "first-extra-detail") == "first"
  assert root.main.effectLookup("https://example.test/deviceauth/token", "second-extra-detail") == "second"
  assert root.main.effectLookup("https://example.test/oauth/token", "third-extra-detail") == "third"
}

test "inline package effect sequence materializes stream outcomes" effects {
  helper/tools.events {
    expect: { method: "GET" },
    sequence: [
      {
        expect: { url: "https://example.test/events/first" },
        stream: [
          helper.EffectResponse { value: "first" },
          helper.EffectResponse { value: ":second" },
        ],
      },
      {
        expect: { url: "https://example.test/events/third" },
        stream: [
          helper.EffectResponse { value: "third" },
        ],
      },
    ],
  }
} {
  assert root.main.effectEvents("https://example.test/events/first") == "first:second", "first stream sequence outcome mismatch"
  assert root.main.effectEvents("https://example.test/events/third") == "third", "second stream sequence outcome mismatch"
}

test "inline service effect bypasses the bound provider by exact contract operation" effects {
  payments/echo {
    expect: "service-request",
    respond: "service-effect-response",
  }
} {
  assert root.main.serviceEffect("service-request") == "service-effect-response"
}
