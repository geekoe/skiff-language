import helper

function owner(input: string) -> string { return "owner" }

function configured() -> string {
  return config.require<string>("app.token")
}

function run() -> string {
  const box = helper.Box { value: "consumer" }
  helper/tools.mutate(box)
  return payments/echo(box.value)
}

function effectLookup(url: string, detail: string) -> string {
  return helper/tools.lookup(helper.EffectRequest {
    method: "POST",
    url: url,
    detail: detail
  }).value
}

function effectEvents(url: string) -> string {
  let output = ""
  const events: Stream<helper.EffectResponse> = helper/tools.events(helper.EffectRequest {
    method: "GET",
    url: url,
    detail: "stream"
  })
  for event in events {
    output = output.concat(event.value)
  }
  return output
}

function serviceEffect(value: string) -> string {
  return payments/echo(value)
}

function leftLabel() -> string {
  return payments/left.label()
}

function rightLabel() -> string {
  return payments/right.label()
}

function leftEvents() -> string {
  let output = ""
  for event in payments/left.events() {
    output = output.concat(event)
  }
  return output
}

function rightEvents() -> string {
  let output = ""
  for event in payments/right.events() {
    output = output.concat(event)
  }
  return output
}
