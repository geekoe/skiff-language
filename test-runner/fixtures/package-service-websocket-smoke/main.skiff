import std

function marker() -> string {
  return "P5-F23D-REAL-COMPONENT-MARKER"
}

function __skiffHttpProbe(body: null) -> string {
  return marker()
}

function websocketConnect(
  request: std.websocket.WebSocketConnectRequest,
  connectionId: string
) -> std.websocket.WebSocketConnectResult {
  return {
    tag: "accept",
    businessIdentity: connectionId,
    connectionPolicy: null
  }
}

type ConnectionCloseRecord {
  connectionId: string,
  closedAt: string,
}

db object ConnectionCloseRecord {
  primary key(connectionId)
}

// Close notification handler: records the client connection teardown into
// the service's persistent state so tests can observe that the router's
// connectionClosed frame reached the service.
function handleConnectionClosed(connectionId: string) -> void {
  db insert ConnectionCloseRecord { connectionId = connectionId closedAt = "closed" }
  return
}
